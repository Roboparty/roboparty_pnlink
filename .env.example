# ./install.sh installs the environment; it does not write runtime configuration.
# PN network settings belong in mocapapi_python/rp1/publish.yaml: pn_network.
# Optional ./run.sh configure writes PN settings there and ROS_DOMAIN_ID here.
# run.sh reads literal assignments and does not execute shell commands in this file.
# Manual Python entry points require loading these assignments explicitly.
# Keep this file to simple KEY=value entries; $PWD denotes the repository root.
# Bundled assets/runtime; no other checkout is required.
PN_RP1_MODEL="$PWD/assets/robots/rp1_description/mjcf/robot_28dof.teleop.xml"
PN_RP1_GMR_ROOT="$PWD/third_party/GMR"
# Usually unnecessary: same-directory bundled SDK takes precedence.
# This fallback is used only when local mocap_api.py / mocap_main_base.py are absent.
# PN_RP1_SDK_DIR=/path/to/official-sdk-sample

# Keep the ROS/system Python separate from the IK/Viser environment.
PN_RP1_SOLVER_PYTHON="$PWD/.venv-ik/bin/python"
PN_RP1_VISER_PYTHON="$PWD/.venv-ik/bin/python"

# Bundled SDK base uses terminal input and does not require pynput.
# For an external older sample that imports pynput, install it separately and:
# PYNPUT_BACKEND=dummy

# Isolated test domain; use the intended domain only after offline checks.
ROS_DOMAIN_ID=217

# Legacy fallback only when the corresponding pn_network YAML field is absent.
# Explicit CLI > YAML > these environment variables > legacy defaults.
# Existing PN_* values do not override a field present in YAML.
# PN_LOCAL_IP=10.42.0.101
# PN_LOCAL_PORT=8002
# PN_SERVER_IP=10.42.0.202
# PN_SERVER_PORT=8080
